generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String     @id @default(cuid())
  name        String
  ownerName   String?
  tenderName  String?
  status      String     @default("draft")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
  outlines    OutlineNode[]
  tasks       AiTask[]
  analyses    TenderAnalysis[]
  requirements TenderRequirement[]
}

model Document {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        String
  fileName    String
  mimeType    String?
  storageKey  String
  markdownKey String?
  status      String   @default("uploaded")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  analyses    TenderAnalysis[]
  requirements TenderRequirement[]
}

model TenderAnalysis {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title       String
  summary     String?
  sections    Json?
  status      String   @default("ready")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requirements TenderRequirement[]

  @@index([projectId])
  @@index([documentId])
}

model TenderRequirement {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  analysisId  String?
  analysis    TenderAnalysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category    String
  title       String
  content     String
  source      String?
  severity    String?
  sortOrder   Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([documentId])
  @@index([analysisId])
  @@index([category])
}

model KnowledgeDocument {
  id          String          @id @default(cuid())
  title       String
  fileName    String?
  storageKey  String?
  status      String          @default("draft")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       KnowledgeItem[]
}

model KnowledgeItem {
  id          String            @id @default(cuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  content     String
  tags        String[]          @default([])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model OutlineNode {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  title       String
  description String?
  content     String?
  sortOrder   Int      @default(0)
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiTask {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  status      String   @default("queued")
  progress    Int      @default(0)
  payload     Json?
  result      Json?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
